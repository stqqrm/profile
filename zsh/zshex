# zshex - zsh wrapper for the zshex C++ binary (Ctrl-E)
#
# Setup (in ~/.zshrc):
#   export ZSHEX_EDITOR=vim          # optional, default: vim
#   source /path/to/zshex.zsh
#
# Binary:  ~/.local/bin/zshex
# Config:  ~/.config/zshex/auth     (optional, for a private repo: one header
#          line such as `Authorization: token github_pat_XXXX`, chmod 600)
#
# If the binary is missing, Ctrl-E downloads zshex.cpp and builds it.
# Run `zshex-update` by hand to pick up a newer version later.
#
# Protocol (binary stdout -> temp file):
#   CD:<path>     directory the UI ended in (we cd there)
#   EDIT:<path>   open this file in $ZSHEX_EDITOR, then relaunch the UI
#
# If you lack permission on a file (not readable, or not writable and not
# yours) and sudo accepts you, the editor is run through sudo.

: ${ZSHEX_EDITOR:=vim}
: ${ZSHEX_URL:=https://raw.githubusercontent.com/stqqrm/zshex/main/src/zshex.cpp}

typeset -g _ZSHEX_BIN=$HOME/.local/bin/zshex
typeset -g _ZSHEX_CONF=$HOME/.config/zshex

_zshex_sha() {
  if (( $+commands[sha256sum] )); then
    command sha256sum | cut -d' ' -f1
  else
    command shasum -a 256 | cut -d' ' -f1
  fi
}

# Download zshex.cpp and compile it from stdin. Skips the build when the
# source is unchanged and the binary exists. The new binary is built under a
# temporary name and moved into place, so a running or working binary is
# never overwritten by a failed build.
zshex-update() {
  local bin=$_ZSHEX_BIN src hash
  local -a auth=()
  [[ -r $_ZSHEX_CONF/auth ]] && auth=(-H "@$_ZSHEX_CONF/auth")

  (( $+commands[curl] )) || { print -u2 "zshex: curl not found"; return 1 }
  (( $+commands[g++] ))  || { print -u2 "zshex: g++ not found"; return 1 }
  mkdir -p -- ${bin:h} $_ZSHEX_CONF || return 1

  src=$(command curl -fsSL $auth $ZSHEX_URL) && [[ -n $src ]] || {
    print -u2 "zshex: download failed: $ZSHEX_URL"
    return 1
  }

  hash=$(print -r -- $src | _zshex_sha)
  if [[ -x $bin && -r $bin.sha256 && $(<$bin.sha256) == $hash ]]; then
    return 0                       # unchanged
  fi

  print -u2 "zshex: building $bin ..."
  if print -r -- $src | command g++ -std=c++17 -O2 -x c++ -o $bin.new - &&
     command mv -f -- $bin.new $bin; then
    print -r -- $hash > $bin.sha256
  else
    command rm -f -- $bin.new
    print -u2 "zshex: build failed"
    return 1
  fi
}

# Ask sudo itself: `sudo -v` succeeds silently if credentials are cached or
# NOPASSWD applies, prompts for your password otherwise, and fails if you are
# not allowed to use sudo (works for "user ALL=(ALL:ALL) ALL" rules too).
_zshex_is_sudoer() {
  (( EUID == 0 )) && return 1
  (( $+commands[sudo] )) || return 1
  command sudo -v </dev/tty
}

_zshex_edit() {
  local f=$1
  local -a ed=(${=ZSHEX_EDITOR})
  if [[ ! -r $f || ( ! -w $f && ! -O $f ) ]] && _zshex_is_sudoer; then
    command sudo "${ed[@]}" -- $f </dev/tty
  else
    command "${ed[@]}" -- $f </dev/tty
  fi
}

zshex-widget() {
  local bin=$_ZSHEX_BIN
  if [[ ! -x $bin ]]; then
    zle -I
    zshex-update
  fi
  [[ -f $bin && -x $bin ]] || { zle -M "zshex: '$bin' is not an executable file (build failed?)"; return }

  local tmp state line dir file pick rc
  tmp=$(mktemp) || return
  state=$(mktemp) || { command rm -f -- $tmp; return }

  zle -I
  while true; do
    local -a args=(--state $state)
    [[ -n $pick ]] && args+=(--select $pick)
    pick=

    command $bin $args >$tmp </dev/tty
    rc=$?

    dir= file=
    while IFS= read -r line; do
      case $line in
        CD:*)   dir=${line#CD:} ;;
        EDIT:*) file=${line#EDIT:} ;;
      esac
    done <$tmp

    [[ -n $dir && -d $dir ]] && builtin cd -- $dir

    if [[ -n $file && -e $file ]]; then
      _zshex_edit $file
      pick=${file:t}          # reopen with the edited file selected
      continue
    fi
    break
  done
  command rm -f -- $tmp $state

  zle reset-prompt
  (( rc )) && zle -M "zshex: exited with status $rc"
}

zle -N zshex-widget
bindkey '^e' zshex-widget
bindkey -M viins '^e' zshex-widget 2>/dev/null
bindkey -M vicmd '^e' zshex-widget 2>/dev/null
