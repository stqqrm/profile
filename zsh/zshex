# zshex - tiny file explorer for zsh, toggled with Ctrl-E
#
# Install:   source /path/to/zshex     (add to ~/.zshrc)
# Use:       Ctrl-E opens a full-screen, colored listing of the current
#            directory. Ctrl-E again (or q / Esc) closes it and gives you
#            your terminal back exactly as it was.
#
# Row format:  -rw-rw-r--  1 stoorm stoorm 20.7MB  5d ago name
#              names get an indicator: dir/  exec*  symlink@
#
# Navigation moves the REAL shell directory (plain `cd`), so you stay in
# whatever directory you navigated to after closing.
#
# Order: sorted by file name (case-insensitive). "." and ".." stay on top,
#        dotfiles / dotdirs group right below them.
#
# Keys while open:
#   j / Down      move down            k / Up       move up
#   PgDn / PgUp   page down / up       gg / G       first / last
#   ~             go home
#   Enter / l / Right   dir: cd into it   file: open in vim (back here after)
#   i             insert the selected name into the prompt and close
#   - / h / Left / Backspace            go to parent directory
#   gd            follow a symlink to its target (file: select it in its dir)
#   Ctrl-O / Ctrl-I (Tab)               directory history back / forward
#   / and ?       search (live filter), n / N repeat
#   f             recursive fzf find (all subdirectories)
#   Ctrl-Z        resume a suspended job (runs your shell's ^Z binding)
#   Ctrl-E / q / Esc                    close
#
# Ctrl-Z inside the editor suspends it and returns to zshex at the same
# spot; press Ctrl-Z in zshex to resume it.
#
# Editor: files open with vim. Override before sourcing, e.g.
#   ZSHEX_EDITOR="nvim"
#
# Search (case-insensitive):
#   Up/Down/PgUp/PgDn move inside the filtered list.
#   The search prompt is on the top line. While you type, the list shows
#   ONLY matching entries of the current directory, ordered exact match,
#   then prefix matches, then substring matches.
#   Enter opens the highlighted match directly (dir: cd, file: vim).
#   Esc cancels and restores the previous selection.
#   n / N then cycle forward / backward through all substring matches.
#
# fzf find (needs fzf installed; otherwise f / Ctrl-F use the local search):
#   f opens it directly. Ctrl-F inside the search prompt toggles between
#   the local filter and the recursive fzf search.
#   Results come from `find` (skipping .git, capped at 100k entries),
#   ranked by `fzf --filter`, top 200 shown, same row format as the
#   normal listing but with the relative path instead of the name.
#   Enter on a directory cd's into it. Enter on a file cd's to its parent
#   directory and opens it in the editor.
# ---------------------------------------------------------------------------
# Colors
#   black red green yellow blue magenta cyan white
#   brightblack brightred brightgreen brightyellow
#   brightblue brightmagenta brightcyan brightwhite
#   default (terminal default)   c0..c255 (256-color palette index)
#
# A value is a space-separated list of words: one color, plus any of
#   bold dim italic underline reverse, and on_<color> for a background.
#   e.g.  "bold brightblue"   "underline red"   "brightwhite on_blue"
#
# Groups:
#   Header       top line                  Info         key-hint line
#   Dir          directories (and . ..)    File         regular files
#   HiddenDir    dot directories           HiddenFile   dot files
#   Exec         executable files          Symlink      symlinks
#   BrokenLink   dangling symlinks         Special      sockets, fifos, devices
#   Visible      perms/links/owner/group/size/age of normal entries
#   Hidden       perms/links/owner/group/size/age of dot entries
#   NoStat       the whole perms/links/owner/group/size/age block when
#                stat data is missing (shown as ---------- 0 root root ...)
#
# Override BEFORE sourcing zshex, e.g. in ~/.zshrc:
#   typeset -A ZSHEX_PROFILE
#   ZSHEX_PROFILE[Dir]="bold brightblue"
#   ZSHEX_PROFILE[Hidden]="brightblack"
#   ZSHEX_PROFILE[NoStat]="bold brightred"
#   source ~/zshex
# ---------------------------------------------------------------------------

zmodload zsh/stat 2>/dev/null
zmodload zsh/datetime 2>/dev/null

typeset -gA ZSHEX_COLORS ZSHEX_PROFILE
ZSHEX_COLORS=(
  black 30        red 31          green 32        yellow 33
  blue 34         magenta 35      cyan 36         white 37
  brightblack 90  brightred 91    brightgreen 92  brightyellow 93
  brightblue 94   brightmagenta 95 brightcyan 96  brightwhite 97
)

_zshex_default() { (( ${+ZSHEX_PROFILE[$1]} )) || ZSHEX_PROFILE[$1]=$2 }

_zshex_default Header       "brightred"
_zshex_default Info         "brightblack"
_zshex_default Dir          "blue"
_zshex_default File         "default"
_zshex_default HiddenDir    "blue"
_zshex_default HiddenFile   "default"
_zshex_default Visible      "default"
_zshex_default Hidden       "default"
_zshex_default NoStat       "brightblack"
_zshex_default Exec         "brightgreen"
_zshex_default Symlink      "cyan"
_zshex_default BrokenLink   "brightred"
_zshex_default Special      "magenta"
unfunction _zshex_default

# set when the editor was suspended (Ctrl-Z): selection to restore on reopen
typeset -g _zshex_resume=

_zshex_sgr() {
  emulate -L zsh
  local w c
  local -a codes
  for w in ${=1}; do
    case $w in
      bold)      codes+=1 ;;
      dim)       codes+=2 ;;
      italic)    codes+=3 ;;
      underline) codes+=4 ;;
      reverse)   codes+=7 ;;
      default|none) ;;
      on_*)      c=${ZSHEX_COLORS[${w#on_}]}; [[ -n $c ]] && codes+=$(( c + 10 )) ;;
      c<->)      codes+="38;5;${w#c}" ;;
      *)         c=${ZSHEX_COLORS[$w]}; [[ -n $c ]] && codes+=$c ;;
    esac
  done
  if (( ${#codes} )); then
    REPLY=$'\e['${(j:;:)codes}m
  else
    REPLY=
  fi
}

_zshex_class() {
  emulate -L zsh
  local p=$1 b=${1:t}
  if [[ -L $p ]]; then
    if [[ -e $p ]]; then REPLY=Symlink; else REPLY=BrokenLink; fi
  elif [[ -d $p ]]; then
    if [[ $b == .* && $b != . && $b != .. ]]; then REPLY=HiddenDir; else REPLY=Dir; fi
  elif [[ -S $p || -p $p || -b $p || -c $p ]]; then
    REPLY=Special
  elif [[ -f $p && -x $p ]]; then
    REPLY=Exec
  elif [[ $b == .* ]]; then
    REPLY=HiddenFile
  else
    REPLY=File
  fi
}

_zshex_ind() {
  case $1 in
    Dir|HiddenDir)       REPLY=/ ;;
    Exec)                REPLY='*' ;;
    Symlink|BrokenLink)  REPLY=@ ;;
    *)                   REPLY= ;;
  esac
}

_zshex_human() {
  emulate -L zsh
  local -F v=$1
  local -a u=(B KB MB GB TB PB)
  local -i i=1
  while (( v >= 1024 && i < ${#u} )); do
    (( v /= 1024, i++ ))
  done
  if (( i == 1 )); then
    REPLY="${1}B"
  else
    printf -v REPLY '%.1f%s' $v ${u[i]}
  fi
}

_zshex_ago() {
  emulate -L zsh
  local -i s=$1
  (( s < 0 )) && s=0
  if (( s < 60 )); then
    REPLY="${s}s ago"
  elif (( s < 3600 )); then
    REPLY="$(( s / 60 ))m ago"
  elif (( s < 86400 )); then
    REPLY="$(( s / 3600 ))h ago"
  elif (( s < 2592000 )); then
    REPLY="$(( s / 86400 ))d ago"
  elif (( s < 31536000 )); then
    REPLY="$(( s / 2592000 ))mo ago"
  else
    REPLY="$(( s / 31536000 ))y ago"
  fi
}

_zshex_tmux_sync() {
  emulate -L zsh
  [[ -n $TMUX ]] || return 0
  command tmux refresh-client -S 2>/dev/null
}

_zshex_paint() {
  emulate -L zsh
  local s=${sg[$1]}
  if [[ -n $s && -n $2 ]]; then
    REPLY=$s$2$'\e[0m'
  else
    REPLY=$2
  fi
}

_zshex_load() {
  emulate -L zsh
  local -a rn rr hidden_keys visible_keys sorted fixed hidden_order rest order w
  local -A st
  local -a c_perm c_nl c_own c_grp c_size c_age c_tgt c_hid c_nostat
  local -i i j=0 k dot=0 dotdot=0 now=$EPOCHSECONDS
  local -i wnl=0 wown=0 wgrp=0 wsize=0 wage=0
  local name cls tcls target ind mt p1 p2 p3 seg tseg mt_s nostat

  rn=("${(@f)$(command ls -1a 2>/dev/null)}")
  rr=("${(@f)$(command ls -la 2>/dev/null)}")
  rr=("${(@)rr[2,-1]}")
  (( ${#rn} == ${#rr} )) || rr=()

  for (( i = 1; i <= ${#rn}; i++ )); do
    case ${rn[i]} in
      .)  dot=$i ;;
      ..) dotdot=$i ;;
      *)
        if [[ ${rn[i]} == .* ]]; then
          hidden_keys+=("${rn[i]}"$'\t'$i)
        else
          visible_keys+=("${rn[i]}"$'\t'$i)
        fi
        ;;
    esac
  done

  # Keep dot entries first, then sort hidden and visible names separately.
  sorted=("${(@oi)hidden_keys}")
  hidden_order=("${(@)sorted##*$'\t'}")
  sorted=("${(@oi)visible_keys}")
  rest=("${(@)sorted##*$'\t'}")
  (( dot ))    && fixed+=($dot)
  (( dotdot )) && fixed+=($dotdot)
  order=($fixed $hidden_order $rest)

  names=(); rows=()
  for k in $order; do
    (( j++ ))
    name=${rn[k]}
    w=(${=rr[k]})
    (( ${#w} >= 4 )) || w=('----------' 0 '?' '?')
    c_perm[j]=${w[1][1,10]}
    c_nl[j]=${w[2]}
    c_own[j]=${w[3]}
    c_grp[j]=${w[4]}

    st=()
    zstat -L -F %s -H st -- "$name" 2>/dev/null
    mt_s=${st[mtime]//[^0-9]/}
    _zshex_human ${st[size]:-0};                 c_size[j]=$REPLY
    _zshex_ago $(( now - ${mt_s:-$now} ));       c_age[j]=$REPLY

    # no usable stat data -> paint the whole info block as one highlight
    nostat=0
    (( ${#w} >= 4 )) || nostat=1
    [[ ${c_perm[j]} == '----------' ]] && nostat=1
    [[ ${c_own[j]} == '?' || ${c_grp[j]} == '?' ]] && nostat=1
    [[ -z ${st[size]} && -z ${st[mtime]} ]] && nostat=1
    c_nostat[j]=$nostat

    c_tgt[j]=
    if [[ -L $name && ${rr[k]} == *" -> "* ]]; then
      c_tgt[j]=${rr[k]#*" -> "}
    fi
    if [[ $name == .* && $name != . && $name != .. ]]; then c_hid[j]=1; else c_hid[j]=0; fi

    (( ${#c_nl[j]}   > wnl   )) && wnl=${#c_nl[j]}
    (( ${#c_own[j]}  > wown  )) && wown=${#c_own[j]}
    (( ${#c_grp[j]}  > wgrp  )) && wgrp=${#c_grp[j]}
    (( ${#c_size[j]} > wsize )) && wsize=${#c_size[j]}
    (( ${#c_age[j]}  > wage  )) && wage=${#c_age[j]}
    names+=("$name")
  done

  for (( j = 1; j <= ${#names}; j++ )); do
    name=${names[j]}
    if (( c_nostat[j] )); then
      mt=NoStat
    elif (( c_hid[j] )); then
      mt=Hidden
    else
      mt=Visible
    fi

    # one joined, right-aligned info block: perms links owner group size age
    p1="${c_perm[j]}  ${(l:$wnl:)c_nl[j]} ${(r:$wown:)c_own[j]} ${(r:$wgrp:)c_grp[j]} ${(l:$wsize:)c_size[j]}  ${(l:$wage:)c_age[j]} "
    _zshex_paint $mt "$p1"; p1=$REPLY

    _zshex_class "$name"; cls=$REPLY
    _zshex_ind $cls;      ind=$REPLY
    [[ $name == . || $name == .. ]] && ind=
    _zshex_paint $cls "$name$ind"; seg=$REPLY

    if [[ -n ${c_tgt[j]} ]]; then
      target=${c_tgt[j]}
      if [[ -e $target ]]; then _zshex_class "$target"; tcls=$REPLY; else tcls=BrokenLink; fi
      _zshex_ind $tcls
      _zshex_paint $cls "$target$REPLY"; tseg=$REPLY
      rows+=("${p1}${seg} > ${tseg}")
    else
      rows+=("${p1}${seg}")
    fi
  done
  n=${#names}; sel=1; top=1
}

# Format an arbitrary list of (relative) paths into names/rows, using the
# same row layout as _zshex_load. Used by the recursive fzf search.
_zshex_fmt() {
  emulate -L zsh
  local -a paths=("$@") c_perm c_nl c_own c_grp c_size c_age c_tgt c_mt
  local -A st
  local -i j now=$EPOCHSECONDS
  local -i wnl=0 wown=0 wgrp=0 wsize=0 wage=0
  local p b p1 cls tcls ind seg tseg mt_s target

  names=(); rows=()

  for (( j = 1; j <= ${#paths}; j++ )); do
    p=${paths[j]}
    st=()
    zstat -L -s -F %s -H st -- "$p" 2>/dev/null
    c_perm[j]=${st[mode]:----------}
    c_nl[j]=${st[nlink]:-0}
    c_own[j]=${st[uid]:-?}
    c_grp[j]=${st[gid]:-?}
    mt_s=${st[mtime]//[^0-9]/}
    _zshex_human ${st[size]:-0};            c_size[j]=$REPLY
    _zshex_ago $(( now - ${mt_s:-$now} ));  c_age[j]=$REPLY
    c_tgt[j]=${st[link]}

    b=${p:t}
    if [[ -z ${st[mode]} ]]; then c_mt[j]=NoStat
    elif [[ $b == .* ]]; then c_mt[j]=Hidden
    else c_mt[j]=Visible
    fi

    (( ${#c_nl[j]}   > wnl   )) && wnl=${#c_nl[j]}
    (( ${#c_own[j]}  > wown  )) && wown=${#c_own[j]}
    (( ${#c_grp[j]}  > wgrp  )) && wgrp=${#c_grp[j]}
    (( ${#c_size[j]} > wsize )) && wsize=${#c_size[j]}
    (( ${#c_age[j]}  > wage  )) && wage=${#c_age[j]}
    names+=("$p")
  done

  for (( j = 1; j <= ${#names}; j++ )); do
    p=${names[j]}
    p1="${c_perm[j]}  ${(l:$wnl:)c_nl[j]} ${(r:$wown:)c_own[j]} ${(r:$wgrp:)c_grp[j]} ${(l:$wsize:)c_size[j]}  ${(l:$wage:)c_age[j]} "
    _zshex_paint ${c_mt[j]} "$p1"; p1=$REPLY

    _zshex_class "$p"; cls=$REPLY
    _zshex_ind $cls;   ind=$REPLY
    _zshex_paint $cls "$p$ind"; seg=$REPLY

    if [[ -n ${c_tgt[j]} ]]; then
      target=${c_tgt[j]}
      if [[ -e ${p:h}/$target || -e $target ]]; then _zshex_class "$target"; tcls=$REPLY; else tcls=BrokenLink; fi
      _zshex_ind $tcls
      _zshex_paint $cls "$target$REPLY"; tseg=$REPLY
      rows+=("${p1}${seg} > ${tseg}")
    else
      rows+=("${p1}${seg}")
    fi
  done
}

_zshex_cd() {
  emulate -L zsh
  local from=$PWD
  builtin cd -- "$1" 2>/dev/null || return
  if [[ $PWD != "$from" ]]; then
    hb+=($from)
    hf=()
    _zshex_tmux_sync
  fi
  _zshex_load
}

_zshex_hist() {
  emulate -L zsh
  local cur=$PWD target
  if [[ $1 == back ]]; then
    (( $#hb )) || return
    target=$hb[-1]
    builtin cd -- $target 2>/dev/null || return
    hb[-1]=()
    hf+=($cur)
  else
    (( $#hf )) || return
    target=$hf[-1]
    builtin cd -- $target 2>/dev/null || return
    hf[-1]=()
    hb+=($cur)
  fi
  _zshex_tmux_sync
  _zshex_load
}

_zshex_select() {
  emulate -L zsh
  local -i k
  for (( k = 1; k <= n; k++ )); do
    if [[ ${names[k]} == "$1" ]]; then sel=$k; return; fi
  done
}

_zshex_up() {
  emulate -L zsh
  [[ $PWD == / ]] && return
  local from=${PWD:t}
  _zshex_cd .. && _zshex_select "$from"
}

_zshex_goto() {
  emulate -L zsh
  if [[ -d $1 ]]; then
    _zshex_cd "$1"
  elif [[ -e $1 ]]; then
    _zshex_cd "${1:h}" && _zshex_select "${1:t}"
  fi
}

_zshex_follow() {
  emulate -L zsh
  [[ -L ${names[sel]} ]] || return
  _zshex_goto "${names[sel]:A}"
}

# Cycle through all substring matches (used by n / N).
_zshex_search() {
  emulate -L zsh
  local q=${(L)1}
  local -i k i step=$2
  (( n > 0 )) || return 1
  for (( i = 1; i <= n; i++ )); do
    k=$(( ((sel - 1 + step * i) % n + n) % n + 1 ))
    if [[ ${(L)names[k]} == *"$q"* ]]; then
      sel=$k
      return 0
    fi
  done
  return 1
}

# Live filter: shows only matching entries while typing.
# Up/Down/PgUp/PgDn/Home/End (and Ctrl-N/Ctrl-P) move inside the filtered list.
# Enter returns the highlighted match (the widget then opens it), Esc restores.
# Ctrl-F toggles recursive fzf mode (results from all subdirectories, same
# row format). Second arg "1" starts in fzf mode.
# In fzf mode, Enter sets fzf_pick (a path relative to $PWD, a local of the
# widget); in local mode fzf_pick stays empty.
_zshex_input() {
  emulate -L zsh
  local c q= cand lq name k2 k3 k tag=
  local -a fn=("${names[@]}") fr=("${rows[@]}") idx exact pre sub cands m
  local -i i s0=$sel t0=$top n0=$n redo=1 rec=${2:-0}

  (( $+commands[fzf] )) || rec=0
  fzf_pick=

  while true; do
    if (( rec && ! ${#cands} )); then
      cands=("${(@f)$(command find . -name .git -prune -o ! -name . -print 2>/dev/null | head -n 100000)}")
      cands=("${(@)cands#./}")
    fi

    if (( redo )); then
      if (( rec )); then
        if [[ -z $q ]]; then
          m=("${(@)cands[1,200]}")
        else
          m=("${(@f)$(print -rl -- "${cands[@]}" | command fzf -i --filter="$q" 2>/dev/null | head -n 200)}")
        fi
        m=("${(@)m:#}")
        _zshex_fmt "${m[@]}"
      else
        lq=${(L)q}
        idx=(); exact=(); pre=(); sub=()
        for (( i = 1; i <= n0; i++ )); do
          cand=${(L)fn[i]}
          if [[ -z $q ]]; then
            idx+=$i
          elif [[ $cand == "$lq" ]]; then
            exact+=$i
          elif [[ $cand == "$lq"* ]]; then
            pre+=$i
          elif [[ $cand == *"$lq"* ]]; then
            sub+=$i
          fi
        done
        [[ -n $q ]] && idx=($exact $pre $sub)

        names=(); rows=()
        for i in $idx; do
          names+=("${fn[i]}")
          rows+=("${fr[i]}")
        done
      fi
      n=${#names}; sel=1; top=1
      redo=0
    fi

    tag=; (( rec )) && tag='fzf '
    _zshex_draw "$tag$1$q"
    if ! read -rsk 1 c; then
      names=("${fn[@]}"); rows=("${fr[@]}"); n=$n0; sel=$s0; top=$t0
      return 1
    fi
    case $c in
      $'\n'|$'\r')
        name=${names[sel]}
        names=("${fn[@]}"); rows=("${fr[@]}"); n=$n0; sel=$s0; top=$t0
        if [[ -n $name ]]; then
          if (( rec )); then
            fzf_pick=$name
          else
            _zshex_select "$name"
          fi
          REPLY=$q
          return 0
        fi
        return 1
        ;;
      $'\x06')                          # Ctrl-F: toggle recursive fzf mode
        if (( $+commands[fzf] )); then
          (( rec = !rec ))
          redo=1
        fi
        ;;
      $'\e')
        if read -rsk 1 -t 0.05 k2 && [[ $k2 == '[' || $k2 == 'O' ]]; then
          k3=
          while read -rsk 1 -t 0.05 k; do
            k3+=$k
            [[ $k == [A-Za-z~] ]] && break
          done
          case $k3 in
            A) (( sel > 1 )) && (( sel-- )) ;;
            B) (( sel < n )) && (( sel++ )) ;;
            5~) sel=$(( sel - win )) ;;
            6~) sel=$(( sel + win )) ;;
            H|1~|7~) sel=1 ;;
            F|4~|8~) sel=$n ;;
          esac
        else
          names=("${fn[@]}"); rows=("${fr[@]}"); n=$n0; sel=$s0; top=$t0
          return 1
        fi
        ;;
      $'\x0e') (( sel < n )) && (( sel++ )) ;;
      $'\x10') (( sel > 1 )) && (( sel-- )) ;;
      $'\x7f'|$'\x08') q=${q%?}; redo=1 ;;
      $'\x15')         q=;       redo=1 ;;
      [[:cntrl:]])     ;;
      *)               q+=$c;    redo=1 ;;
    esac
  done
}

# Open a file in the editor (default vim; override with ZSHEX_EDITOR).
# Leaves the alternate screen while the editor runs, then comes back.
# Sets `stopped` (a local of zshex-widget) if the editor was suspended with
# Ctrl-Z; the widget then reopens itself at the same spot (see zshex-widget).
_zshex_open() {
  emulate -L zsh
  local -a ed
  local saved junk
  local -i alt=1
  ed=(${=ZSHEX_EDITOR:-vim})
  # vim: stay on zshex's alternate screen (vim must not switch screens
  # itself). Job notices like "[1] + suspended" are then printed on that
  # screen and wiped by the next redraw instead of leaking into the shell.
  if [[ ${ed[1]:t} == (vim|vi) ]]; then
    alt=0
    ed+=(--cmd 'set t_ti= t_te=')
  fi
  # remember the terminal mode zle is using: zsh resets the tty to its
  # "cooked" mode after a foreground job, which makes our key reads block
  saved=$(stty -g </dev/tty 2>/dev/null)
  print -rn -- $'\e[?7h\e[?25h'
  (( alt )) && print -rn -- $'\e[?1049l'
  zle -I 2>/dev/null
  # eval, so the job text reads "command vim -- file" (not "command $ed ...").
  # Job-list helpers (e.g. an auto-bg hook keyed on the command name) then
  # recognise the editor; otherwise a suspended editor gets `bg`'d and
  # bounces between "continued" and "suspended (tty output)".
  eval "command ${(q@)ed} -- ${(q)1} </dev/tty"
  local -i rc=$?
  [[ -n $saved ]] && stty "$saved" </dev/tty 2>/dev/null
  # drop leftover input (e.g. late terminal replies sent to the editor)
  while read -rsk 1 -t 0.02 junk </dev/tty; do :; done
  (( alt )) && print -rn -- $'\e[?1049h'
  print -rn -- $'\e[0m\e[2J\e[?25l\e[?7l'
  if (( rc > 128 )); then
    case ${signals[rc-127]} in
      TSTP|TTIN|TTOU) stopped=1 ;;
    esac
  fi
}

# Enter: directory -> cd into it, file -> open in editor and come back.
_zshex_enter() {
  emulate -L zsh
  local name=${names[sel]}
  [[ -n $name ]] || return
  if [[ -d $name ]]; then
    _zshex_cd "$name"
  else
    _zshex_open "$name"
    (( stopped )) && return
    _zshex_load
    _zshex_select "$name"
  fi
}

_zshex_draw() {
  emulate -L zsh
  local line buf hdr foot=$1
  local -i i
  win=$(( LINES - 3 )); (( win < 3 )) && win=3
  (( sel > n )) && sel=n
  (( sel < 1 )) && sel=1
  (( sel < top )) && top=sel
  (( sel >= top + win )) && top=$(( sel - win + 1 ))

  if [[ -n $foot ]]; then
    _zshex_paint Header "$foot  [$n matches]"
  else
    _zshex_paint Header " zshex  ${PWD/#$HOME/~}  [$sel/$n]"
  fi
  hdr=$REPLY
  buf=$'\e[?25l\e[H\e[2K'"$hdr"$'\n'
  for (( i = top; i < top + win; i++ )); do
    if (( i <= n )); then
      line=${rows[i]}
      if (( i == sel )); then
        line=${line//$'\e[0m'/$'\e[0m\e[7m'}
        buf+=$'\e[2K\e[7m'"$line"$'\e[K\e[0m\n'
      else
        buf+=$'\e[2K'"$line"$'\n'
      fi
    else
      buf+=$'\e[2K\n'
    fi
  done
  if [[ -n $foot ]]; then
    _zshex_paint Info " enter open  up/down pgup/pgdn move  ^F fzf/local  esc cancel  (matches only)"
  else
    _zshex_paint Info " j/k move  enter open (vim)  i insert name  - up  ~ home  gd follow  / ? search  f fzf find  ^O ^I back/fwd  ^Z fg  q close"
  fi
  buf+=$'\e[2K'"$REPLY"$'\e[J'
  # put the cursor at the end of the search prompt on the top line
  [[ -n $foot ]] && buf+=$'\e[1;'$(( ${#foot} + 1 ))$'H\e[?25h'
  print -rn -- "$buf"
}

zshex-widget() {
  emulate -L zsh
  setopt local_options no_nomatch

  local -a names rows hb hf
  local -A sg
  local key k2 k3 name line buf k sq hint pending= fzf_pick=
  local -i sel=1 top=1 win n=0 i sd=1 s0=0 stopped=0

  for k in ${(k)ZSHEX_PROFILE}; do
    _zshex_sgr "${ZSHEX_PROFILE[$k]}"
    sg[$k]=$REPLY
  done

  _zshex_load
  if [[ -n $_zshex_resume ]]; then
    _zshex_select "$_zshex_resume"
    _zshex_resume=
  fi

  print -rn -- $'\e[?1049h\e[?25l\e[?7l'
  {
    while true; do
      _zshex_draw

      read -rsk 1 key || break
      case $key in
        $'\x05'|q) break ;;
        $'\x1a')                       # Ctrl-Z: close and let the shell's ^Z (fg) run
          if (( ${#jobtexts} )); then
            pending=$'\x1a'
            break
          fi
          ;;
        j) (( sel < n )) && (( sel++ )) ;;
        k) (( sel > 1 )) && (( sel-- )) ;;
        g)
          read -rsk 1 k2
          case $k2 in
            g) sel=1 ;;
            d) _zshex_follow ;;
          esac
          ;;
        G) sel=$n ;;
        '~') _zshex_cd ~ ;;
        -|h|$'\x7f'|$'\x08') _zshex_up ;;
        $'\x0f') _zshex_hist back ;;
        $'\t') _zshex_hist fwd ;;
        '/'|'?'|f)
          fzf_pick=
          local -i start_rec=0
          if [[ $key == f ]]; then
            sd=1; start_rec=1
            _zshex_input / 1 && sq=$REPLY || start_rec=-1
          else
            [[ $key == '?' ]] && sd=-1 || sd=1
            _zshex_input $key 0 && sq=$REPLY || start_rec=-1
          fi
          if (( start_rec != -1 )); then
            if [[ -n $fzf_pick ]]; then
              if [[ -d $fzf_pick ]]; then
                _zshex_cd "$fzf_pick"
              else
                _zshex_cd "${fzf_pick:h}" && _zshex_select "${fzf_pick:t}"
                _zshex_enter
              fi
            else
              _zshex_enter
            fi
          fi
          ;;
        n) [[ -n $sq ]] && _zshex_search "$sq" $sd ;;
        N) [[ -n $sq ]] && _zshex_search "$sq" $(( -sd )) ;;
        l|$'\n'|$'\r') _zshex_enter ;;
        i)
          name=${names[sel]}
          if [[ -n $name ]]; then
            LBUFFER+="${(q)name} "
            break
          fi
          ;;
        $'\e')
          if read -rsk 1 -t 0.05 k2; then
            if [[ $k2 == '[' || $k2 == 'O' ]]; then
              k3=
              while read -rsk 1 -t 0.05 k; do
                k3+=$k
                [[ $k == [A-Za-z~] ]] && break
              done
              case $k3 in
                A) (( sel > 1 )) && (( sel-- )) ;;
                B) (( sel < n )) && (( sel++ )) ;;
                D) _zshex_up ;;
                C) _zshex_enter ;;
                5~) sel=$(( sel - win )) ;;
                6~) sel=$(( sel + win )) ;;
                H|1~|7~) sel=1 ;;
                F|4~|8~) sel=$n ;;
                '105;5u') _zshex_hist fwd ;;
              esac
            fi
          else
            break
          fi
          ;;
      esac
      if (( stopped )); then            # editor was suspended: reopen right here
        _zshex_resume=${names[sel]}
        pending=$'\x05'
        break
      fi
    done
  } always {
    print -rn -- $'\e[?7h\e[?25h\e[?1049l'
  }
  _zshex_tmux_sync
  zle reset-prompt
  [[ -n $pending ]] && zle -U "$pending"
}

zle -N zshex-widget
bindkey '^e' zshex-widget
bindkey -M viins '^e' zshex-widget 2>/dev/null
bindkey -M vicmd '^e' zshex-widget 2>/dev/null
