# ~/.zshrc  --  /etc/zsh/zshrc
# Packages: zsh zsh-autosuggestions zsh-syntax-highlighting fzf (zsh-completions optional)

export XDG_RUNTIME_DIR=/run/user/$UID

# --- Options ---------------------------------------------------------------
setopt EXTENDED_GLOB INTERACTIVE_COMMENTS NO_BEEP PROMPT_SUBST
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt COMPLETE_IN_WORD ALWAYS_TO_END LIST_PACKED
unsetopt PROMPT_SP
bindkey -e
KEYTIMEOUT=1                    # bare Esc fires fast; Alt/arrow sequences still match
WORDCHARS=''                    # word motions stop at / . -

# Tab stops every 4 columns, set with cursor escapes (`tabs 4` writes a row of
# spaces, which wraps into a blank line if the window resizes during startup)
_set_tabs() {
    local c
    print -n '\e[3g\r'
    for (( c = 5; c <= 400; c += 4 )); do print -n "\e[${c}G\eH"; done
    print -n '\r'
}
_set_tabs; unfunction _set_tabs
export LESS='-R -x4'

# --- History ---------------------------------------------------------------
HISTFILE=${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history
HISTSIZE=100000
SAVEHIST=100000
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}
setopt SHARE_HISTORY EXTENDED_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS HIST_FIND_NO_DUPS

# --- Colors ----------------------------------------------------------------
if (( $+commands[dircolors] )); then
    if [[ -r ~/.dircolors ]]; then eval "$(dircolors -b ~/.dircolors)"; else eval "$(dircolors -b)"; fi
fi

alias ls='ls --color=auto'
alias ll='ls -lh --color=auto'
alias la='ls -lAh --color=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'

export LESS_TERMCAP_mb=$'\e[1;31m'
export LESS_TERMCAP_md=$'\e[1;34m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_us=$'\e[4;32m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_so=$'\e[30;43m'
export LESS_TERMCAP_se=$'\e[0m'

# --- Completion ------------------------------------------------------------
[[ -d /usr/share/zsh-completions ]] && fpath+=(/usr/share/zsh-completions)
[[ -d ~/.zsh/completions ]] && fpath+=(~/.zsh/completions)

autoload -Uz compinit
mkdir -p ~/.cache/zsh
# rebuild the dump once a day, otherwise trust the cache
if [[ -n ~/.cache/zsh/zcompdump(#qN.mh+24) ]]; then
    compinit -d ~/.cache/zsh/zcompdump
else
    compinit -C -d ~/.cache/zsh/zcompdump
fi

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' verbose yes
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{8}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}no matches%f'
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path ~/.cache/zsh/zcompcache
zstyle ':completion:*:*:kill:*' menu yes select
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:cd:*' tag-order local-directories directory-stack path-directories

# --- Plugins ---------------------------------------------------------------
_source_first() {
    local f
    for f in "$@"; do
        [[ -r $f ]] && { source "$f"; return 0 }
    done
    return 1
}

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
_source_first \
    /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
    /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
    ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
# syntax highlighting is sourced at the bottom (must be last)

# --- Key bindings ----------------------------------------------------------
autoload -Uz add-zsh-hook up-line-or-beginning-search down-line-or-beginning-search edit-command-line
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zle -N edit-command-line

bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[[H'  beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[OH'  beginning-of-line
bindkey '^[[F'  end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[OF'  end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[1;3D' backward-word
bindkey '^[[Z' reverse-menu-complete
bindkey '^[^?' backward-kill-word
bindkey '^X^E' edit-command-line

# Esc: tmux copy-mode
_esc_widget() { [[ -n $TMUX ]] && tmux copy-mode 2>/dev/null; return 0 }
zle -N _esc_widget
bindkey '^[' _esc_widget

# --- fzf -------------------------------------------------------------------
(( $+commands[fzf] )) && source <(fzf --zsh)    # Ctrl-R history, Alt-C cd

# Ctrl-G: fuzzy cd into a subdirectory
_fzf_dir() {
    local dir
    dir=$(find . -type d 2>/dev/null \
        | fzf -i --exact --query="$BUFFER" --preview='ls {}' --height=40% --reverse)
    [[ -n $dir ]] && builtin cd -- "$dir"
    zle reset-prompt
}
zle -N _fzf_dir
bindkey '^G' _fzf_dir

# Ctrl-T: fuzzy-pick a file and open it in vim
_fzf_file() {
    local file
    file=$(find . -type f 2>/dev/null | fzf -i --exact --preview='cat {}' --height=40% --reverse)
    if [[ -n $file ]]; then
        zle push-input
        BUFFER="vim ${(q)${file#./}}"
        zle accept-line
    else
        zle reset-prompt
    fi
}
zle -N _fzf_file
bindkey '^T' _fzf_file

# --- Jobs: Ctrl-Z = smart fg (1 job: fg, several: fzf picker) --------------
# The widget only queues a command; the picker and `fg` run outside ZLE
# (running them inside a widget hangs the terminal).
_smart_fg_run() {
    local -a ids cur prev rest
    local k id sel list=""
    for k in ${(kno)jobtexts}; do
        case ${${(s.:.)jobstates[$k]}[2]} in
            +) cur=($k) ;;
            -) prev=($k) ;;
            *) rest=($k $rest) ;;
        esac
    done
    ids=($cur $prev $rest)
    (( $#ids )) || return 0

    id=$ids[1]
    if (( $#ids > 1 )); then
        for k in $ids; do list+="$k  ${jobstates[$k]%%:*}  ${jobtexts[$k]}"$'\n'; done
        # SIGTSTP is ignored in the picker so a stray Ctrl-Z can't stop fzf
        sel=$(trap '' TSTP; print -rn -- "$list" \
            | fzf --height=40% --reverse --prompt='Jobs> ' --bind='ctrl-z:accept' \
                  --tiebreak=index --header='Enter / Ctrl-Z: fg   Esc: cancel') || return 0
        id=${sel%% *}
    fi
    _noise_fg=1
    fg %$id
}
_smart_fg() {
    (( ${#jobtexts} )) || return 0
    zle push-input
    BUFFER=' _smart_fg_run'
    _noise_echo=1
    zle accept-line
}
zle -N _smart_fg
bindkey '^Z' _smart_fg

# Hide zsh's job chatter ("suspended", "continued") by erasing it afterwards
typeset -gi _noise_echo=0 _noise_fg=0
typeset -g  _noise_cmd=''

_noise_preexec() {
    _noise_cmd=$1
    (( _noise_echo )) && print -n "\e[1A\r\e[J"
}
_noise_precmd() {
    local st=$? n=0 cmd=$_noise_cmd
    _noise_cmd=''
    if [[ -n $cmd ]]; then
        (( _noise_fg )) || [[ $cmd == (fg|bg)(|\ *) || $cmd == %* ]] && (( n += 1 ))
        (( st == 148 )) && (( n += 2 ))     # Ctrl-Z: "suspended" line + blank line
    fi
    _noise_echo=0
    _noise_fg=0
    (( n )) && print -n "\e[${n}A\r\e[J"
}
add-zsh-hook preexec _noise_preexec
precmd_functions=(_noise_precmd ${precmd_functions:#_noise_precmd})   # first, keeps $?

# After Ctrl-Z, resume the job in the background instead of leaving it stopped.
# Programs that need the terminal would just stop again, so they stay stopped.
typeset -ga _bg_keep_stopped=(vim nvim vi nano less man htop btop top ssh fzf)
_autobg_precmd() {
    local k cmd
    for k in ${(k)jobstates}; do
        [[ ${jobstates[$k]%%:*} == suspended* ]] || continue
        cmd=${${(z)jobtexts[$k]}[1]:t}
        (( ${_bg_keep_stopped[(Ie)$cmd]} )) && continue
        bg %$k >/dev/null 2>&1
    done
}
add-zsh-hook precmd _autobg_precmd

# --- Directory history: Ctrl-O back, Ctrl-I / Ctrl-] / Alt-I forward -------
typeset -ga _dir_back _dir_fwd
typeset -gi _dir_nav=0

_dir_track() {
    (( _dir_nav )) && return
    [[ -z $OLDPWD || $OLDPWD == $PWD ]] && return
    _dir_back+=($OLDPWD)
    _dir_fwd=()
    (( $#_dir_back > 100 )) && _dir_back=(${_dir_back[-100,-1]})
}
add-zsh-hook chpwd _dir_track

_dir_go_back() {
    (( $#_dir_back )) || return 0
    local cur=$PWD target=$_dir_back[-1]
    _dir_back[-1]=()
    _dir_nav=1
    builtin cd -- $target 2>/dev/null && _dir_fwd+=($cur)
    _dir_nav=0
    zle reset-prompt
}
_dir_go_fwd() {
    (( $#_dir_fwd )) || return 0
    local cur=$PWD target=$_dir_fwd[-1]
    _dir_fwd[-1]=()
    _dir_nav=1
    builtin cd -- $target 2>/dev/null && _dir_back+=($cur)
    _dir_nav=0
    zle reset-prompt
}
zle -N _dir_go_back
zle -N _dir_go_fwd
bindkey '^O'  _dir_go_back
bindkey '^[i' _dir_go_fwd
bindkey '^]'  _dir_go_fwd
bindkey '^[[105;5u' _dir_go_fwd     # Ctrl-I (needs the Alacritty binding, see alacritty.toml)

# --- Functions -------------------------------------------------------------
truecolor() {
    bash -c '
n=$(tput cols)
for ((i=0;i<n*2;i++)); do
    h=$((i*360/(n*2)))
    x=$((h/60))
    p=$((h%60*255/60))
    case $x in
        0) r=255; g=$p; b=0 ;;
        1) r=$((255-p)); g=255; b=0 ;;
        2) r=0; g=255; b=$p ;;
        3) r=0; g=$((255-p)); b=255 ;;
        4) r=$p; g=0; b=255 ;;
        5) r=255; g=0; b=$((255-p)) ;;
    esac
    if ((i%2)); then printf "\e[38;2;%d;%d;%dm▐" "$r" "$g" "$b"
    else printf "\e[48;2;%d;%d;%dm" "$r" "$g" "$b"
    fi
done
printf "\e[0m\n"
'
}

logout() { loginctl terminate-user $USER }
null() { "$@" >/dev/null 2>&1 &! }          # run detached and silenced

# --- Prompt: user@host ~   (~ in $HOME, / in /, $ elsewhere) ---------------
_prompt_loc() {
    case $PWD in
        $HOME) print -rn -- '~' ;;
        /)     print -rn -- '/' ;;
        *)     print -rn -- '$' ;;
    esac
}
# steady block cursor, as a zero-width prompt sequence
_cursor_block=$'%{\e[2 q%}'
PROMPT="${_cursor_block}"'%B%F{11}%n%f%b@%B%F{red}%M%f%b $(_prompt_loc) '

# --- tty1 login: 3 second countdown before launching the session -----------
_tty1_launch() {
    local launch=true i
    for i in 3 2 1; do
        printf '\rLaunching gnome in %s... (press any key to cancel)' $i
        if read -sk1 -t 1; then launch=false; break; fi
    done
    echo
    if [[ $launch == true ]]; then
        : # labwc
    fi
}
if [[ -o login && -z $WAYLAND_DISPLAY && $(tty) == /dev/tty1 ]]; then
    _tty1_launch
fi
unfunction _tty1_launch 2>/dev/null

# --- Syntax highlighting (must be sourced last) ----------------------------
_source_first \
    /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

if (( ${+ZSH_HIGHLIGHT_STYLES} )); then
    ZSH_HIGHLIGHT_STYLES[command]='fg=blue'
    ZSH_HIGHLIGHT_STYLES[builtin]='fg=blue'
    ZSH_HIGHLIGHT_STYLES[function]='fg=blue'
    ZSH_HIGHLIGHT_STYLES[alias]='fg=blue'
    ZSH_HIGHLIGHT_STYLES[precommand]='fg=blue,underline'
    ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=red'
    ZSH_HIGHLIGHT_STYLES[path]='underline'
    ZSH_HIGHLIGHT_STYLES[comment]='fg=8'
    ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=yellow'
    ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=yellow'
    ZSH_HIGHLIGHT_STYLES[redirection]='fg=cyan'
    ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=cyan'
fi

# --- tmux autostart (skip with NO_TMUX=1; never for root) ------------------
# Prefix the tmux line with `exec` to close the terminal when tmux exits.
_tmux_autostart() {
    [[ -z $TMUX ]] && (( ! ${+NO_TMUX} )) && (( EUID != 0 )) && (( $+commands[tmux] )) || return 0
    tmux new-session -d -s "$USER-$$" \; \
        new-window \; new-window \; new-window \; new-window \; \
        select-window -t 1 \; \
        set-option -g destroy-unattached on \; \
        attach >/dev/null 2>&1
}
_tmux_autostart
